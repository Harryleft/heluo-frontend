{
  "name": "heluo-react-fullstack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typescript": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "docs:check": "node scripts/docs-check.mjs",
    "dev:frontend": "node scripts/release-port.js 3000 && vite",
    "dev:server": "node scripts/release-port.js 9011 && cross-env PORT_AUTO_FALLBACK=false node --watch server/src/index.js",
    "dev:embedding": "python server/embedding-service/server.py",
    "start:server": "node server/src/index.js",
    "dev:llm": "python server/llm-service/server.py",
    "dev": "concurrently -n \"server,frontend,embedding,llm\" -c \"blue,green,yellow,magenta\" \"npm run dev:server\" \"npm run dev:frontend\" \"npm run dev:embedding\" \"npm run dev:llm\"",
    "cmd": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1",
    "cmd:check": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 check",
    "cmd:build": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 build",
    "cmd:docs-check": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 docs-check",
    "cmd:single-file-commit-check": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 single-file-commit-check",
    "cmd:docs-init": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 docs-init",
    "cmd:server-health": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 server-health"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.15",
    "@assistant-ui/react-markdown": "^0.12.5",
    "@assistant-ui/react-ui": "^0.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.7",
    "@vitejs/plugin-react": "4.3.3",
    "axios": "1.7.7",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "cors": "2.8.5",
    "digest-fetch": "3.1.1",
    "dotenv": "16.4.7",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "express": "4.21.1",
    "i18next": "25.5.3",
    "lru-cache": "^11.2.6",
    "mirador": "4.0.0",
    "morgan": "1.10.0",
    "react": "18.3.1",
    "react-bootstrap": "2.10.5",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.28.0",
    "styled-components": "6.1.13",
    "vis-timeline": "^8.5.0",
    "vite": "5.4.11",
    "vite-plugin-eslint": "1.8.1",
    "vite-tsconfig-paths": "5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@stylistic/eslint-plugin": "2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/styled-components": "5.1.34",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "9.15.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "^27.0.1",
    "msw": "^2.12.10",
    "prettier": "3.3.3",
    "stylelint": "16.10.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-recommended": "14.0.1",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.7.2",
    "vitest": "^3.2.4"
  }
}
