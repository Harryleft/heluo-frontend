{
  "name": "heluo-react-fullstack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typescript": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "bootstrap": "bash scripts/start-all.sh",
    "bootstrap:fast": "bash scripts/start-all.sh --no-install",
    "bootstrap:browser": "bash scripts/start-all.sh --with-browser",
    "bootstrap:docker": "bash scripts/start-all.sh --with-docker",
    "smoke": "node scripts/smoke-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "dev:frontend": "node scripts/release-port.js 3000 && vite",
    "dev:server": "node scripts/release-port.js 9011 && cross-env PORT_AUTO_FALLBACK=false node --watch server/src/index.js",
    "dev:embedding": "server/embedding-service/.venv/bin/python server/embedding-service/server.py",
    "start:server": "node server/src/index.js",
    "dev:llm": "server/embedding-service/.venv/bin/python server/llm-service/server.py",
    "dev": "concurrently -n \"server,frontend,embedding\" -c \"blue,green,yellow\" \"npm run dev:server\" \"npm run dev:frontend\" \"npm run dev:embedding\"",
    "dev:full": "concurrently -n \"server,frontend,embedding,llm\" -c \"blue,green,yellow,magenta\" \"npm run dev:server\" \"npm run dev:frontend\" \"npm run dev:embedding\" \"npm run dev:llm\"",
    "cmd": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1",
    "cmd:check": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 check",
    "cmd:build": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 build",
    "cmd:docs-check": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 docs-check",
    "cmd:single-file-commit-check": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 single-file-commit-check",
    "cmd:docs-init": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 docs-init",
    "cmd:server-health": "powershell -ExecutionPolicy Bypass -File scripts/commands.ps1 server-health"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.15",
    "@assistant-ui/react-markdown": "^0.12.5",
    "@assistant-ui/react-ui": "^0.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "axios": "^1.18.1",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "cors": "2.8.5",
    "digest-fetch": "3.1.1",
    "dotenv": "16.4.7",
    "express": "^4.22.2",
    "i18next": "^25.5.3",
    "lru-cache": "^11.2.6",
    "mirador": "4.0.0",
    "morgan": "^1.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.30.4",
    "vis-timeline": "^8.5.0"
  },
  "devDependencies": {
    "@csstools/css-parser-algorithms": "^4.0.0",
    "@csstools/css-tokenizer": "^4.0.0",
    "@eslint/js": "9.15.0",
    "@types/node": "22.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.6",
    "concurrently": "9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "^15.15.0",
    "jsdom": "^27.0.1",
    "node-fetch": "^3.3.2",
    "typescript": "5.7.2",
    "vite": "^5.4.21",
    "vite-plugin-eslint": "^1.8.1",
    "vite-tsconfig-paths": "^5.1.2",
    "vitest": "^3.2.6"
  }
}
