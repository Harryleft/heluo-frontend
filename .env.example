# Heluo JS 全栈本地配置示例
# 后端请复制到 server/.env 使用

PORT=9011
MARKLOGIC_BASE_URL=http://127.0.0.1:8003
MARKLOGIC_USER=admin
MARKLOGIC_PASSWORD=admin

# Frontend
REACT_BACKEND_URL=http://127.0.0.1:9011
APP_ENV=development
# 默认使用开源 Leaflet（无须高德 Key）；需要回退到高德时设 REACT_MAP_PROVIDER=amap
REACT_MAP_PROVIDER=leaflet
REACT_AMAP_KEY=
REACT_AMAP_SECURITY_JS_CODE=
# 可选：自定义 Leaflet CDN 与地图底图（默认 jsDelivr + OpenStreetMap）
REACT_LEAFLET_JS_URL=https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js
REACT_LEAFLET_CSS_URL=https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css
REACT_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
REACT_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# 搜索模式配置
# 可选值: keyword | vector | hybrid
# - keyword: 纯关键字搜索
# - vector: 纯向量语义搜索
# - hybrid: 混合搜索（关键字+向量，推荐）
HELUO_SEARCH_MODE=hybrid

# LLM 服务配置（用于融合问答）
# 启用 LLM 生成回答（true/false）
LLM_ENABLED=true
# LLM 提供方标识（当前实现用于追踪标签）
LLM_PROVIDER=openai
# LLM 服务地址（如 vLLM/Ollama 的 OpenAI 兼容 API）
LLM_BASE_URL=http://127.0.0.1:4000
# OpenAI 兼容聊天接口路径
LLM_CHAT_PATH=/v1/chat/completions
# 模型名称
LLM_MODEL=Xunzi-Qwen1.5-4B
# 备用模型（逗号分隔；主模型失败时按顺序回退）
LLM_FALLBACK_MODELS=deepseek-chat
# 请求超时（毫秒）
LLM_TIMEOUT=30000
# 最大生成 token 数
LLM_MAX_TOKENS=
# 生成温度 (0-1)
LLM_TEMPERATURE=0.4
# 鉴权头配置（可选）
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization
LLM_API_KEY_PREFIX=Bearer

# Phoenix 追踪（可选）
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_URL=
PHOENIX_API_KEY=
PHOENIX_PROJECT=heluo-rag
